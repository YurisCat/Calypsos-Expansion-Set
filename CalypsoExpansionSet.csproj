<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CalypsoExpansionSet</AssemblyName>
    <RootNamespace>CalypsoExpansionSet</RootNamespace>
    <Version>0.2.77</Version>
    <Product>Calypso's Expansion Set</Product>
    <Authors>YurisCat;Masaicker</Authors>
    <Copyright>Copyright © 2026 YurisCat, Masaicker</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <InvokyrPath Condition="'$(InvokyrPath)' == ''">E:\Steam\steamapps\common\Invokyr</InvokyrPath>
    <InteropPath Condition="'$(InteropPath)' == ''">$(InvokyrPath)\BepInEx\interop</InteropPath>
    <BepPath Condition="'$(BepPath)' == ''">$(InvokyrPath)\BepInEx\core</BepPath>
    <PluginPath Condition="'$(PluginPath)' == ''">$(InvokyrPath)\BepInEx\plugins\CalypsoExpansionSet</PluginPath>
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
    <IdolAudioPath Condition="'$(IdolAudioPath)' == ''">$(MSBuildProjectDirectory)\Assets\Audio</IdolAudioPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="scripts\ScreenEffectsBuild.cs" />
    <Compile Remove="scripts\PingBuild.cs" />
    <EmbeddedResource Include="Assets\Pings\shared_pings.bundle" LogicalName="CalypsoExpansionSet.Pings.bundle" />
    <Compile Remove="scripts\LobbyBoxBuild.cs" />
    <EmbeddedResource Include="Assets\LobbyBox\box.cesmodel" LogicalName="CalypsoExpansionSet.LobbyBox.box.cesmodel" />
    <EmbeddedResource Include="Assets\LobbyBox\bilibili-line.rgba" LogicalName="CalypsoExpansionSet.LobbyBox.bilibili.rgba" />
    <EmbeddedResource Include="Assets\Curses\disguise.rgba" LogicalName="CalypsoExpansionSet.Curses.disguise.rgba" />
    <EmbeddedResource Include="Assets\ScreenEffects\idol_screen.bundle" LogicalName="CalypsoExpansionSet.ScreenEffects.bundle" />
    <EmbeddedResource Include="Assets\StickyNote\note.mesh.json" LogicalName="CalypsoExpansionSet.StickyNote.note.mesh.json" />
    <EmbeddedResource Include="Assets\StickyNote\paper.note" LogicalName="CalypsoExpansionSet.StickyNote.paper.note" />
    <EmbeddedResource Include="Assets\StickyNote\Baked\handdrawn_*.notedelta;Assets\StickyNote\Baked\jumping.notedelta" LogicalName="CalypsoExpansionSet.StickyNote.Artwork.%(Filename).notedelta" />
    <EmbeddedResource Include="$(IdolAudioPath)\duck_steps.pcm" LogicalName="CalypsoExpansionSet.Audio.duck_steps.pcm" />
    <EmbeddedResource Include="$(IdolAudioPath)\spring_accent.pcm" LogicalName="CalypsoExpansionSet.Audio.spring_accent.pcm" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3"
                      PrivateAssets="all" IncludeAssets="build;contentFiles" />
  </ItemGroup>

  <ItemGroup>
    <!-- Invokyr 主游戏代码在 vhs，Assembly-CSharp 提供辅助类型。 -->
    <Reference Include="$(InteropPath)\vhs.dll" Private="false" Publicize="true" />
    <Reference Include="$(InteropPath)\vhs.Audio.dll" Private="false" />
    <Reference Include="$(InteropPath)\DissonanceVoip.dll" Private="false" />
    <Reference Include="$(InteropPath)\I2.dll" Private="false" />
    <Reference Include="$(InteropPath)\Cinemachine.dll" Private="false" />
    <Reference Include="$(InteropPath)\Assembly-CSharp*.dll" Private="false" />
    <Reference Include="$(InteropPath)\UnityEngine.CoreModule.dll" Private="false" Publicize="true" />
    <Reference Include="$(InteropPath)\Unity*.dll" Exclude="$(InteropPath)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(InteropPath)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(InteropPath)\Il2CppSystem*.dll" Private="false" />
    <Reference Include="$(InteropPath)\Mirror*.dll" Private="false" />
    <Reference Include="$(InteropPath)\FMODUnity.dll" Private="false" />
    <Reference Include="$(InteropPath)\Enhanced*.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepPath)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepPath)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepPath)\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(BepPath)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepPath)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BepPath)\Il2CppInterop.Runtime.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(IdolAudioPath)\duck_steps.pcm') Or !Exists('$(IdolAudioPath)\spring_accent.pcm')"
           Text="缺少构建音效，请完整同步 Assets/Audio 中的 duck_steps.pcm 和 spring_accent.pcm；重新生成资源的方法见 Assets/Audio/README.md。" />
    <Error Condition="!Exists('$(InteropPath)\vhs.dll')"
           Text="找不到 Invokyr 的 vhs.dll，请检查 InvokyrPath 或 InteropPath，并先运行游戏生成 interop 程序集。" />
    <Error Condition="!Exists('$(BepPath)\BepInEx.Unity.IL2CPP.dll')"
           Text="找不到 BepInEx.Unity.IL2CPP.dll，请检查 BepPath 和 BepInEx IL2CPP 安装。" />
  </Target>

  <Target Name="DeployPlugin" AfterTargets="Build"
          Condition="'$(DeployToGame)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <MakeDir Directories="$(PluginPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginPath)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="CalypsoExpansionSet 已部署到 $(PluginPath)\$(TargetFileName)。游戏运行中时需重启以加载新 DLL。" />
  </Target>

</Project>
